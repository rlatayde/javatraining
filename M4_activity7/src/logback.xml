
<configuration>
    <!-- Console Appender (SHORT time) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- HH:mm:ss.SSS -->
            <pattern>%d{HH:mm:ss.SSS} [%level] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File Appender (FULL date) -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <!-- Ensure 'logs/' directory exists -->
        <file>logs/application.log</file>
        <append>true</append>
        <encoder>
            <!-- yyyy-MM-dd HH:mm:ss.SSS -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger at INFO, writing to both appenders -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
